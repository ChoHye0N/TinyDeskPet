// 실행 파일 버전 정보 리소스. CMake가 configure_file로 값을 채웁니다.
// 탐색기에서 DeskPet.exe → 속성 → 자세히 탭에 표시됩니다.
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DeskPet Project"
            VALUE "FileDescription",  "DeskPet desktop companion"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "DeskPet"
            VALUE "OriginalFilename", "DeskPet.exe"
            VALUE "ProductName",      "DeskPet"
            VALUE "ProductVersion",   "@PROJECT_VERSION@+@DESKPET_GIT_HASH@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
